<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.1</version>
        <relativePath/>
    </parent>

    <groupId>ru.iac</groupId>
    <artifactId>inscheck</artifactId>
    <version>2.0.0</version>
    <packaging>war</packaging>
    <name>InsCheck</name>
    <description>ON-LINE проверка полисов (А14). Перенос SOAP-сервиса GetInsPrkState с Oracle/ASP.NET на PostgreSQL/Spring Boot.</description>

    <properties>
        <java.version>17</java.version>
    </properties>

    <dependencies>
        <!-- SOAP (контракт идентичен старому сервису: метод GetInsPrkState, теги query/answer) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web-services</artifactId>
        </dependency>
        <dependency>
            <groupId>wsdl4j</groupId>
            <artifactId>wsdl4j</artifactId>
        </dependency>

        <!-- Доступ к БД строго через DAO-слой: NamedParameterJdbcTemplate + sql в отдельных файлах -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Встроенный Tomcat нужен только для запуска fat-jar через main().
             При деплое war во внешний Tomcat контейнер предоставляет его сам,
             поэтому scope=provided (иначе конфликт классов сервлет-контейнера). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-tomcat</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- Имя артефакта = InsCheckR.war → контекст-путь /InsCheckR во внешнем Tomcat,
             SOAP-эндпоинт: http://<host>:8080/InsCheckR/ws -->
        <finalName>InsCheckR</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
